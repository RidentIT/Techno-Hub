{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=technohub;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "RefreshCookie": {
    "Secure": false,
    "SameSite": "Lax"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  },
  "Swagger": {
    "Enabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "TechnoHub": "Debug"
      }
    }
  }
}
