# Copy to .env.local and adjust.

# Where the ASP.NET Core staff API lives. Used only by the Next.js route handlers
# (server side), which is why it has no NEXT_PUBLIC_ prefix — the refresh token
# must never be reachable from the browser.
BACKEND_API_URL=http://localhost:5080

# Same API, but this value IS sent to the browser: data calls go straight from the
# client to the API with the in-memory access token as a Bearer header.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# Name of the httpOnly cookie this app sets on its own origin to hold the refresh token.
SESSION_COOKIE_NAME=th_admin_session
